load("//bzl/valdi:valdi_application.bzl", "valdi_application", "valdi_application_icons")
load("@rules_cc//cc:defs.bzl", "cc_binary")

valdi_application(
    name = "three_native",
    android_activity_theme_name = "Theme.MyApp.Launch",
    android_resource_files = glob(["app_assets/android/**"]),
    icons = valdi_application_icons(src = "app_assets/icon.png"),
    ios_bundle_id = "com.snap.valdi.threenative",
    ios_families = ["iphone"],
    linux_windowed = True,
    root_component_path = "App@three_native/src/ThreeNativeApp",
    title = "Valdi Three Native",
    version = "0.1.0",
    deps = ["//apps/three_native/src/valdi/three_native"],
)

# The Linux platter adapter consumes the same Valdi custom-view attributes as
# the Android GLES3 view, in a native SDL2 Wayland/X11 window.
cc_binary(
    name = "three_native_linux_gl",
    srcs = ["src/linux/ThreeNativeLinux.cpp"],
    linkopts = ["-lSDL2", "-lGLESv2"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//apps/three_native/src/valdi/three_native:three_native_native",
        "//valdi:valdi_linux",
    ],
)

# Verifies that Valdi and a native JSI binding share the same Hermes runtime
# and that installation can run synchronously on its owning JavaScript thread.
cc_binary(
    name = "three_native_linux_jsi_probe",
    srcs = ["src/linux/HermesJsiProbe.cpp"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//apps/three_native/src/valdi/three_native:three_native_native",
        "//valdi:valdi_linux",
        "@hermes//:hermes_api",
    ],
)

cc_binary(
    name = "three_native_linux_webgpu_probe",
    srcs = ["src/linux/WebGPUJsiProbe.cpp"],
    linkopts = ["-ldl", "-pthread"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//apps/three_native/native_webgpu:rnwgpu_api",
        "//apps/three_native/src/valdi/three_native:three_native_native",
        "//valdi:valdi_linux",
        "@hermes//:hermes_api",
    ],
)

cc_binary(
    name = "three_native_linux_webgpu_surface_probe",
    srcs = ["src/linux/WebGPUSurfaceProbe.cpp"],
    linkopts = ["-lSDL3", "-ldl", "-pthread"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//apps/three_native/native_webgpu:rnwgpu_api",
        "//apps/three_native/src/valdi/three_native:three_native_native",
        "//valdi:valdi_linux",
        "@hermes//:hermes_api",
    ],
)
